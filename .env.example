# Скопируйте этот файл в .env.local и заполните значения.
# .env.local не попадает в git и не передаётся в браузер.

# Обязательно для генерации через ИИ. Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Модель Groq. Нужна модель, которая понимает фото и JSON Schema.
# qwen/qwen3.8-27b — preview-модель Groq: её могут заменить или отключить с коротким уведомлением.
GROQ_MODEL=qwen/qwen3.8-27b

# Общее хранилище лимитов — Upstash Redis (бесплатного тарифа хватает). Нужно для Vercel и любого
# хостинга с несколькими экземплярами: без него счётчики живут в памяти каждого экземпляра отдельно.
# Значения — в консоли Upstash (REST API). При подключении через Vercel Marketplace переменные
# KV_REST_API_URL / KV_REST_API_TOKEN тоже подходят. Если Redis задан, но недоступен, генерация
# временно отключается (ответ 503), чтобы не потерять контроль над расходами на ИИ.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Защита от ботов Cloudflare Turnstile (необязательно): https://dash.cloudflare.com/?to=/:account/turnstile
# Нужны ОБА ключа. Секретный ключ — только на сервере. Публичный попадает в браузер при сборке.
# Для локальной проверки Cloudflare даёт тестовые ключи: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Лимиты генераций.
# PER_DAY — бесплатная пробная квота на один IP за 24 часа; это же число показывается на лендинге
# (оно попадает в страницу при сборке — после изменения пересоберите проект).
# GENERATION_LIMIT_PER_HOUR=10
# GENERATION_LIMIT_PER_DAY=5
# GENERATION_LIMIT_GLOBAL_PER_DAY=300

# Почта для обратной связи и заявок на платный пакет (ссылки mailto: на сайте).
# Без неё ссылки «Сообщить об ошибке», «Оставить отзыв» и «Оставить заявку» не показываются.
# Значение попадает в браузерный код при сборке — после изменения нужна пересборка.
NEXT_PUBLIC_CONTACT_EMAIL=

# Публичный адрес сайта для превью ссылок в соцсетях и мессенджерах, например https://listcraft.example.com
# На Vercel можно не указывать — Next.js возьмёт адрес проекта.
# Он же — адрес для ссылок в письмах (подтверждение почты, сброс пароля) и для возврата из Яндекс ID.
# Если включены аккаунты, в production укажите его: заголовку Host не доверяем (на Vercel запасной
# вариант — VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=

# Аккаунты — Supabase Auth (необязательно; без этих переменных вход и регистрация выключены).
# Project Settings → API Keys. Publishable key можно показывать в браузере, secret key — нельзя.
# В Supabase: Authentication → Sign In / Providers → Email: включите Confirm email, минимальная длина пароля 8.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ (sb_secret_...) — только на сервере, нужен лишь для входа через Яндекс ID.
# Никогда не добавляйте к нему префикс NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Вход через Яндекс ID (необязательно): https://oauth.yandex.ru/client/new
# Платформа «Веб-сервисы», Redirect URI: <SITE_URL>/auth/yandex/callback
# Доступы: «Доступ к адресу электронной почты» (login:email) и «Доступ к логину, имени и фамилии, полу» (login:info).
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
