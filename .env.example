# Скопируйте этот файл в .env.local и заполните значения.
# .env.local не попадает в git и не передаётся в браузер.

# Обязательно для генерации через ИИ. Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Модель Groq. Нужна модель, которая понимает фото и JSON Schema.
# qwen/qwen3.8-27b — preview-модель Groq: её могут заменить или отключить с коротким уведомлением.
GROQ_MODEL=qwen/qwen3.8-27b

# Простые лимиты генераций (в памяти процесса — только для локального/закрытого теста).
# PER_DAY — бесплатная пробная квота на один IP за 24 часа; это же число показывается на лендинге
# (оно попадает в страницу при сборке — после изменения пересоберите проект).
# GENERATION_LIMIT_PER_HOUR=10
# GENERATION_LIMIT_PER_DAY=5
# GENERATION_LIMIT_GLOBAL_PER_DAY=300

# Почта для обратной связи и заявок на платный пакет (ссылки mailto: на сайте).
# Без неё ссылки «Сообщить об ошибке», «Оставить отзыв» и «Оставить заявку» не показываются.
# Значение попадает в браузерный код при сборке — после изменения нужна пересборка.
NEXT_PUBLIC_CONTACT_EMAIL=

# Публичный адрес сайта для превью ссылок в соцсетях и мессенджерах, например https://listcraft.example.com
# На Vercel можно не указывать — Next.js возьмёт адрес проекта.
SITE_URL=
